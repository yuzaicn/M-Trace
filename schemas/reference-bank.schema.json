{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m-trace.dev/schemas/reference-bank-v1.1.json",
  "title": "M-Trace reference fingerprint bank",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bankVersion",
    "extractorVersion",
    "suiteVersion",
    "contentHash",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "bankVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "extractorVersion": { "const": "1.0.0" },
    "suiteVersion": { "const": "2.0.0" },
    "contentHash": { "$ref": "#/$defs/hash" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "bankVersion",
        "contentHash",
        "vendor",
        "modelId",
        "modelFamily",
        "samplingSource",
        "requestShape",
        "effort",
        "generationOptions",
        "transport",
        "usage",
        "systemFingerprint",
        "collectedAt",
        "environments",
        "fingerprint",
        "calibration"
      ],
      "properties": {
        "entryId": { "type": "string" },
        "bankVersion": { "type": "string" },
        "contentHash": { "$ref": "#/$defs/hash" },
        "vendor": { "const": "OpenAI" },
        "modelId": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "modelFamily": { "enum": ["gpt-5.5", "gpt-5.6", "gpt-6"] },
        "marketingName": { "type": "string" },
        "providerHint": { "type": "string" },
        "samplingSource": { "const": "provider-default" },
        "requestShape": {
          "enum": [
            "openai-chat-completions",
            "openai-reasoning-chat-completions",
            "openai-responses",
            "anthropic-messages"
          ]
        },
        "effort": { "type": ["string", "null"] },
        "generationOptions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        },
        "transport": { "enum": ["direct", "tunnel", "mixed"] },
        "usage": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/jsonValue" }
            }
          ]
        },
        "systemFingerprint": { "type": ["string", "null"] },
        "collectedAt": { "type": "string", "format": "date-time" },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environmentId", "wireFormat", "sampleCount"],
            "properties": {
              "environmentId": { "type": "string" },
              "wireFormat": { "enum": ["openai", "anthropic"] },
              "sampleCount": { "type": "integer", "minimum": 1 },
              "wrapperId": { "type": "string" }
            }
          }
        },
        "fingerprint": { "type": "object" },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxDistance",
            "minMargin",
            "minRelativeMargin",
            "distanceScale",
            "nuisanceDirections",
            "frozenAt",
            "sampleCount"
          ],
          "properties": {
            "maxDistance": { "type": "number", "minimum": 0 },
            "minMargin": { "type": "number", "minimum": 0 },
            "minRelativeMargin": { "type": "number", "minimum": 0 },
            "distanceScale": { "type": "number", "exclusiveMinimum": 0 },
            "nuisanceDirections": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "number" }
              }
            },
            "frozenAt": { "type": "string", "format": "date-time" },
            "sampleCount": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
